// ==========================================================
// Portofolio - Lilis Kesia Aprilia Ambarita
// File: portofolio.scss  (sumber)  ->  portofolio.css (hasil kompilasi)
// Warna diambil dari foto: biru tua seragam + cokelat kayu meja
//
// Kompilasi:  sass portofolio.scss portofolio.css
// Pantau:     sass --watch portofolio.scss:portofolio.css
// ==========================================================


// ---------- Variabel ----------
// Warna
$navy:      #14213d;
$navy-soft: #1f3257;
$wood:      #d9922e;
$wood-soft: #f6e3c4;
$paper:     #f4f6fa;
$white:     #ffffff;
$text:      #1c2538;
$muted:     #566077;
$line:      #d5dae6;
$on-navy:   #d9e0f0;  // teks terang di atas latar biru tua
$nav-link:  #cdd6ea;
$ghost-line: #51648c;

// Font
$font-head: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
$font-body: "Nunito Sans", "Segoe UI", system-ui, sans-serif;

// Ukuran dan tata letak
$radius:     20px;
$maxw:       1080px;
$gutter:     clamp(20px, 5vw, 48px);
$col-gap:    clamp(24px, 6vw, 72px);
$breakpoint: 820px;


// ---------- Mixin ----------
// Gaya berlaku di layar selebar $bp atau lebih kecil
@mixin respond-below($bp: $breakpoint) {
  @media (max-width: $bp) {
    @content;
  }
}

// Gaya judul memakai font heading
@mixin heading($weight: 700) {
  font-family: $font-head;
  font-weight: $weight;
}

// Tata letak dua kolom (judul di kiri, isi di kanan); jadi satu kolom di layar kecil
@mixin two-columns {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: $col-gap;
  align-items: start;

  @include respond-below {
    grid-template-columns: 1fr;
  }
}

// Panel berwarna untuk cita-cita dan hobi
@mixin panel {
  border-radius: $radius;
  padding: clamp(28px, 5vw, 44px);
}


// ---------- Reset ringan ----------
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;

  @media (prefers-reduced-motion: reduce) {
    scroll-behavior: auto;
  }
}

body {
  margin: 0;
  background: $paper;
  color: $text;
  font-family: $font-body;
  font-size: 1.0625rem;
  line-height: 1.65;
}

img {
  display: block;
  max-width: 100%;
}

h1,
h2,
h3,
p,
ul,
ol,
dl,
dd,
figure {
  margin: 0;
}

ul,
ol {
  padding: 0;
  list-style: none;
}

a {
  color: inherit;
}

:focus-visible {
  outline: 3px solid $wood;
  outline-offset: 3px;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.skip-link {
  position: absolute;
  left: 12px;
  top: -60px;
  z-index: 10;
  padding: 10px 16px;
  border-radius: 8px;
  background: $wood;
  color: $navy;
  font-weight: 700;
  text-decoration: none;

  &:focus {
    top: 12px;
  }
}


// ---------- Hero ----------
.hero {
  background: $navy;
  color: $white;
  padding: 0 $gutter clamp(48px, 8vw, 96px);

  &-grid {
    max-width: $maxw;
    margin: clamp(24px, 5vw, 56px) auto 0;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);

    @include respond-below {
      grid-template-columns: 1fr;
    }
  }

  &-role {
    color: $wood;
    font-weight: 700;
    margin-bottom: 14px;
  }

  &-name {
    @include heading(800);
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: 22px;
  }

  &-lead {
    max-width: 46ch;
    font-size: 1.15rem;
    color: $on-navy;
    margin-bottom: 32px;
  }

  &-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  // Foto berbentuk lengkungan, dengan bingkai cokelat kayu di belakangnya
  &-photo {
    position: relative;
    isolation: isolate;
    justify-self: center;
    width: 100%;
    max-width: 340px;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      transform: translate(14px, 14px);
      border: 3px solid $wood;
      border-radius: 999px 999px $radius $radius;
    }

    img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: 50% 36%;
      border-radius: 999px 999px $radius $radius;
      background: $navy-soft;
    }

    // Di layar kecil foto tampil lebih dulu
    @include respond-below {
      order: -1;
      max-width: 260px;
      justify-self: start;
    }
  }
}


// ---------- Navigasi ----------
.nav {
  max-width: $maxw;
  margin: 0 auto;
  padding: 22px 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 24px;

  &-brand {
    @include heading;
    font-size: 1.05rem;
  }

  &-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;

    a {
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      color: $nav-link;
      padding-bottom: 2px;
      border-bottom: 2px solid transparent;

      &:hover {
        color: $white;
        border-bottom-color: $wood;
      }
    }
  }
}


// ---------- Tombol ----------
.btn {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  border: 2px solid transparent;
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }

  &-primary {
    background: $wood;
    color: $navy;

    &:hover {
      background: $wood-soft;
    }
  }

  &-ghost {
    border-color: $ghost-line;
    color: $white;

    &:hover {
      border-color: $white;
    }
  }
}


// ---------- Section umum ----------
.section {
  max-width: $maxw;
  margin: 0 auto;
  padding: clamp(48px, 8vw, 88px) $gutter;

  &-title {
    @include heading(800);
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: $navy;
  }
}


// ---------- Tentang ----------
.about {
  @include two-columns;

  &-body p {
    max-width: 60ch;
    margin-bottom: 28px;
  }
}

.facts {
  border-top: 1px solid $line;

  > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid $line;

    @include respond-below {
      grid-template-columns: 6rem 1fr;
    }
  }

  dt {
    color: $muted;
    font-weight: 600;
  }

  dd {
    font-weight: 700;
  }
}


// ---------- Pendidikan (urutan dari terbaru ke terlama) ----------
.education {
  @include two-columns;
  border-top: 1px solid $line;
}

.timeline {
  position: relative;
  padding-left: 32px;

  &::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: $line;
  }

  &-item {
    position: relative;
    padding-bottom: 32px;

    &:last-child {
      padding-bottom: 0;
    }

    &::before {
      content: "";
      position: absolute;
      left: -32px;
      top: 6px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: $paper;
      border: 3px solid $navy;
    }

    &.is-current::before {
      background: $wood;
      border-color: $wood;
    }

    h3 {
      @include heading;
      font-size: 1.25rem;
      line-height: 1.3;
      color: $navy;
    }

    p {
      color: $muted;
    }
  }
}


// ---------- Cita-cita dan hobi ----------
.goals {
  padding-top: 0;

  &-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;

    @include respond-below {
      grid-template-columns: 1fr;
    }
  }
}

.dream {
  @include panel;
  background: $navy;
  color: $white;

  h3 {
    @include heading(800);
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    line-height: 1.15;
    margin-bottom: 12px;
    color: $wood;
  }

  p {
    max-width: 40ch;
    color: $on-navy;
  }
}

.hobby {
  @include panel;
  background: $wood-soft;
  color: $navy;

  h3 {
    @include heading;
    font-size: 1.4rem;
    line-height: 1.2;
    margin-bottom: 10px;
  }
}


// ---------- Kontak ----------
.contact {
  @include two-columns;
  border-top: 1px solid $line;

  &-mail {
    @include heading;
    display: inline-block;
    font-size: clamp(1.2rem, 3.4vw, 1.9rem);
    color: $navy;
    text-decoration: underline;
    text-decoration-color: $wood;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;

    &:hover {
      background: $wood-soft;
    }
  }

  &-place {
    margin-top: 12px;
    color: $muted;
  }
}


// ---------- Footer ----------
.footer {
  background: $navy;
  color: $nav-link;
  padding: 36px $gutter;
  text-align: center;

  p {
    max-width: 60ch;
    margin: 0 auto;
    font-family: $font-head;
    font-size: 1.1rem;
  }
}
